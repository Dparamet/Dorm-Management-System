generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TENANT
}

enum RoomStatus {
  VACANT // ว่าง
  OCCUPIED // มีคนเช่า
  MAINTENANCE // ซ่อมบำรุง
  RESERVED // จองแล้ว
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(TENANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rooms Room[] // 1 User เช่าได้หลายห้อง (One-to-Many)
}

model Room {
  id         String     @id @default(cuid())
  roomNumber String     @unique
  floor      Int
  price      Float
  status     RoomStatus @default(VACANT)
  roomType   String? // เช่น "Fan", "Air-Con"

  // Relations
  tenantId String?
  tenant   User?   @relation(fields: [tenantId], references: [id])
  bills    Bill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bill {
  id          String  @id @default(cuid())
  month       String // เช่น "2026-04"
  rentPrice   Float // ค่าเช่าห้องเดือนนั้น
  waterUnit   Int // หน่วยน้ำ
  elecUnit    Int // หน่วยไฟ
  totalAmount Float // ยอดรวม
  isPaid      Boolean @default(false) // จ่ายยัง?

  // Relations
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
